{
  "_doc": "The allow/deny list .claude/settings.json should carry (see permissions/POLICY.md). Agents cannot edit .claude/settings.json themselves; Sai copies this block there.",
  "permissions": {
    "allow": [
      "mcp__Notion",
      "mcp__Indeed__search_jobs",
      "mcp__Indeed__get_job_details",
      "mcp__Tsenta__get-job-recommendations",
      "mcp__Tsenta__get-job-details",
      "mcp__Tsenta__get-jobs-by-ids",
      "mcp__Tsenta__list-inbox-messages",
      "mcp__Tsenta__get-inbox-message",
      "mcp__Tsenta__get-application-balance",
      "mcp__Tsenta__get-application-status",
      "mcp__Tsenta__list-applications",
      "mcp__Tsenta__list-resume-profiles",
      "mcp__Tsenta__get-resume-profile",
      "mcp__Tsenta__get-profile-status",
      "mcp__Tsenta__request-resume-upload",
      "mcp__Tsenta__check-custom-resume",
      "Bash(curl -sS -o /dev/null -w * -X PUT -H \"Content-Type: application/pdf\" --data-binary @* https://storage.googleapis.com/autojobs-prod/custom-resume-uploads/*)",
      "mcp__Gmail__search_threads",
      "mcp__Gmail__get_thread",
      "mcp__Gmail__get_message",
      "mcp__Gmail__list_labels",
      "mcp__Tsenta__get-subscription-info",
      "mcp__Tsenta__get-apply-preferences",
      "mcp__Tsenta__fetch-job-description",
      "mcp__Tsenta__apply-with-custom-resume",
      "mcp__Tsenta__get-inbox-thread",
      "mcp__Tsenta__get-inbox-unread-count",
      "mcp__Tsenta__list-tracked-applications",
      "mcp__Tsenta__track-application",
      "mcp__Tsenta__update-tracked-application",
      "Bash(.venv/bin/python -m auto_apply*)",
      "Bash(.venv/bin/pip install*)",
      "Bash(python3 -m venv*)",
      "Bash(pdflatex*)",
      "Bash(bash */build.sh*)",
      "Bash(python3 */screen.py*)",
      "Bash(python3 */numbers.py*)",
      "Bash(pdftotext*)",
      "Bash(pdftoppm*)",
      "Bash(pdfinfo*)"
    ],
    "deny": [
      "mcp__Notion__notion-delete-pages",
      "mcp__Notion__notion-delete-databases",
      "mcp__Notion__notion-delete-comment",
      "mcp__Tsenta__apply-to-job",
      "mcp__Tsenta__delete-tracked-application",
      "mcp__Tsenta__delete-resume-profile",
      "mcp__Tsenta__commit-auto-apply-config",
      "mcp__Gmail__send_message",
      "mcp__Gmail__trash_message",
      "mcp__Gmail__trash_thread"
    ]
  }
}
